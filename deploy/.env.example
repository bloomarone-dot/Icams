# Fichier .env pour /var/www/icams sur le VPS

POSTGRES_USER=icams
POSTGRES_PASSWORD=changez_moi_mot_de_passe_fort
POSTGRES_DB=icams

# URL publique (CORS) — ex: https://icams.bloomarone.com
CORS_ORIGINS=https://icams.bloomarone.com,http://icams.bloomarone.com

# Port Docker interne (8080 car nginx hôte occupe le 80)
HTTP_PORT=8080

# Optionnel : URL complète (sinon construite automatiquement depuis POSTGRES_*)
# DATABASE_URL=postgresql+psycopg://icams:motdepasse@db:5432/icams
