# Copier vers /var/www/icams/.env sur le VPS

# Mot de passe PostgreSQL (obligatoire — changez-le)
POSTGRES_USER=icams
POSTGRES_PASSWORD=changez_moi_mot_de_passe_fort
POSTGRES_DB=icams

# URL publique du site (pour CORS) — ex: http://123.45.67.89 ou https://icams.votredomaine.com
CORS_ORIGINS=http://VOTRE_IP_OU_DOMAINE

# Port HTTP exposé (80 par défaut)
HTTP_PORT=80
